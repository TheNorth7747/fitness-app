{
  "name": "fitday",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "tsx server/src/index.ts",
    "lint": "oxlint",
    "test": "tsx --test server/test/*.test.ts",
    "preview": "vite preview",
    "media:fetch": "python3 scripts/fetch-media.py"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.1.11",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@electric-sql/pglite-socket": "^0.2.15",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "playwright-core": "^1.64.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "description": "手机优先的力量训练 PWA：计划向导自定义、渐进负荷、训练草稿、中文动作库与力量趋势",
  "license": "MIT"
}
