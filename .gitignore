# 原始开源数据集 17MB，仅在本地重新生成数据时需要
data/

# 构建脚本（仅本地使用）
tools/

# Agent 工作记忆与本地状态
.workbuddy/
.workbudty/

# 系统与编辑器
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# 日志与临时文件
*.log
npm-debug.log*
*.tmp
*.bak
.cache/
temp/

# 依赖目录（项目零依赖，留作兜底）
node_modules/
__pycache__/
*.pyc

# 打包产物
*.tar
*.tar.gz
*.zip
*.rar
*.7z

